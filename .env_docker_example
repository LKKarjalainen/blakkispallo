NODE_ENV=production
TOKEN=token here
# Must match BLAKKIS_DB_PASSWORD in .env_db
DATABASE_URL=postgres://blakkis:change-me-db-password@blakkis-db:5432/blakkis
BOT_MODE=polling
NEWRELIC=false
# At least 16 characters, e.g. `openssl rand -hex 32`. Changing it makes stored nicks unreadable.
SECRET=reallylonganduniquesecretstring
# Your Telegram user id (numeric). Empty disables admin commands and error reports
ADMIN_ID=
# Bot username without @. If empty, it is looked up from Telegram at startup
BOT_USERNAME=
